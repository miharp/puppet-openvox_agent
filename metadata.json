{
  "name": "miharp-openvox_agent",
  "version": "0.1.1-rc0",
  "author": "Mike Harp",
  "summary": "Installs and upgrades openvox-agent from a Puppet run, including the switch from Puppet 7 and between OpenVox major versions",
  "license": "Apache-2.0",
  "source": "https://github.com/miharp/puppet-openvox_agent",
  "project_page": "https://github.com/miharp/puppet-openvox_agent",
  "issues_url": "https://github.com/miharp/puppet-openvox_agent/issues",
  "tags": [
    "openvox",
    "agent",
    "upgrade",
    "puppet_agent"
  ],
  "dependencies": [],
  "operatingsystem_support": [
    {
